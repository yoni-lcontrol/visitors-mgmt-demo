{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Amadeus Service: Debug",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/migdal-amadeus-service/bin/Debug/net9.0/Amadeus8.dll",
      "args": [],
      "cwd": "${workspaceFolder}/migdal-amadeus-service",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:5051;http://localhost:5050"
      },
      "preLaunchTask": "build-amadeus"
    }
  ],
  "tasks": [
    {
      "label": "build-amadeus",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/migdal-amadeus-service/Amadeus8.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}