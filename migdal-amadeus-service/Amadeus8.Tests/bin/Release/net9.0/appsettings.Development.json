{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Warning",
      "Amadeus8": "Debug"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "None"
      }
    }
  },
  "Amadeus": {
    "EnableHostedServices": true,
    "InfrastructureImportBatchSize": 100
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=AmadeusIntegration_Dev;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AmadeusImport": {
    "ImportAccessLevels": false
  },
  "Backend": {
    "BaseUrl": "http://localhost:3000"
  }
}