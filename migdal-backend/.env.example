# =============================================
# Application
# =============================================
APP_NAME=Migdal
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200
KIOSK_URL=http://localhost:4201
KIOSK_API_KEY=f0910c859a9bd9eccbd492a9c44c65152ec0af958682bc1fc4ca0c2790ce6acf

# =============================================
# Database (MSSQL)
# =============================================
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=admin
DB_PASSWORD=sniper123!
DB_DATABASE=migdal_db
DB_DOMAIN=
DB_ENCRYPT=false


# =============================================
# JWT
# =============================================
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# =============================================
# Remote Access Control Server
# =============================================
ACCESS_CONTROL_REMOTE_URL=http://localhost:5050

# =============================================
# SMS Provider
# =============================================
SMS_REMOTE_URL=http://localhost:4000/api/sms

# =============================================
# Email (SMTP)
# =============================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@migdal.local
EMAIL_RECIPIENTS=

# =============================================
# Kerberos / Windows SSO (SPNEGO)
# =============================================
KERBEROS_ENABLED=true
KERBEROS_UNKNOWN_USER_MODE=deny
KERBEROS_DEFAULT_ROLE=Viewer

# =============================================
# AD Sync
# =============================================
AD_SYNC_BATCH_SIZE=50

# =============================================
# Logging
# =============================================
LOG_LEVEL=debug

# =============================================
# SIEM (Syslog)
# =============================================
SIEM_SYSLOG_HOST=
SIEM_SYSLOG_PORT=514
SIEM_SYSLOG_PROTOCOL=tcp
SIEM_SYSLOG_TOKEN=
