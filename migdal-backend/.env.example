# =============================================
# Application
# =============================================
APP_NAME=Migdal
APP_PORT=3000
APP_ENV=development
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# =============================================
# Database (MSSQL)
# =============================================
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=admin
DB_PASSWORD=sniper123!
DB_DATABASE=migdal_db

# =============================================
# JWT
# =============================================
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# =============================================
# Remote Access Control Server
# =============================================
ACCESS_CONTROL_REMOTE_URL=http://localhost:5050

# =============================================
# SMS Provider
# =============================================
SMS_REMOTE_URL=http://localhost:4000/api/sms

# =============================================
# Email (SMTP)
# =============================================
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@migdal.local
EMAIL_RECIPIENTS=

# =============================================
# Microsoft Entra ID (Azure AD)
# =============================================
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUTHORITY=https://login.microsoftonline.com/<tenant-id>
ENTRA_REDIRECT_URI=http://localhost:4200
ENTRA_POST_LOGOUT_REDIRECT_URI=http://localhost:4200
ENTRA_API_AUDIENCE=api://<backend-app-client-id>
APP_ID_URI=
ENTRA_UNKNOWN_USER_MODE=deny
ENTRA_AUTO_PROVISION=false
ENTRA_DEFAULT_ROLE=Viewer

# =============================================
# AD Sync
# =============================================
AD_SYNC_BATCH_SIZE=50

# =============================================
# Logging
# =============================================
LOG_LEVEL=debug
