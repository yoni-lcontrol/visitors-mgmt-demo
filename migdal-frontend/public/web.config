<?xml version="1.0" encoding="utf-8"?>
<!--
  Deployed alongside the built frontend SPA (dist/migdal-frontend/browser) as the IIS site's
  web.config. Lives in public/ so the Angular CLI's existing "assets" glob (**/* from public)
  copies it into the build output automatically — no angular.json change needed.

  Requires, on the IIS server, before this works:
    - URL Rewrite module installed
    - Application Request Routing (ARR) module installed, with "Enable proxy" turned on
      under the server-level ARR "Server Proxy Settings" (this is NOT settable from web.config)
    - "Enable WebSocket Protocol" support: install the IIS-WebSockets Windows feature
    - migdal-backend is on a SEPARATE server from this one (not co-located) — replace
      __BACKEND_HOST__ below with its real hostname or IP before deploying (e.g. 10.0.0.50
      or migdal-backend.internal). Do not deploy this file with the placeholder still in it.
    - Keep Windows Authentication OFF / Anonymous only on this site — Kerberos SSO is handled
      inside the backend's Node process (node-expose-sspi), so this site must pass the
      Authorization header through untouched rather than consuming it itself.

  This proxies REST calls (/api/*) and the Socket.IO transport (/socket.io/*, used by the
  /ws/users namespace) to migdal-backend, so the admin SPA and the backend appear on this site's
  single public port. Everything else falls back to index.html for Angular client-side routing.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="ProxyToBackendApi" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="http://__BACKEND_HOST__:3000/api/{R:1}" />
        </rule>
        <rule name="ProxyToBackendSocketIO" stopProcessing="true">
          <match url="^socket\.io/(.*)" />
          <action type="Rewrite" url="http://__BACKEND_HOST__:3000/socket.io/{R:1}" />
        </rule>
        <rule name="AngularSpaFallback" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
