<?xml version="1.0" encoding="utf-8"?>
<configuration>
<startup>
<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
</startup>
<runtime>
<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
<dependentAssembly>
<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
</dependentAssembly>
<dependentAssembly>
<assemblyIdentity name="System.Text.Json" publicKeyToken="cc7b13ffcd2ddd51" culture="neutral" />
<bindingRedirect oldVersion="0.0.0.0-7.0.0.2" newVersion="7.0.0.2" />
</dependentAssembly>
</assemblyBinding>
</runtime>
<appSettings>
<!-- Port the local kiosk-facing WebSocket server listens on. The paired kiosk
     (on the same LAN, possibly a different workstation) connects to
     ws://<this-machine>:<LocalServerPort>/scanner/. Requires a URL ACL
     reservation (netsh http add urlacl) and an inbound firewall rule. -->
<add key="LocalServerPort" value="5900" />

<!-- Shared secret the connecting kiosk must present in its "hello" handshake.
     Must match the SCANNER_TOKEN configured in that kiosk's kiosk-config.json. -->
<add key="LocalServerToken" value="CHANGE-ME-PER-DEPLOYMENT" />

<!-- Machine identifier (defaults to Environment.MachineName if empty) -->
<add key="MachineId" value="" />

<!-- Scanner poll interval in ms - how often to check for documents in tray (default: 500) -->
<add key="ScannerPollIntervalMs" value="500" />

<!-- Base interval between scanner USB reconnect attempts in ms (default: 3000) -->
<add key="ScannerReconnectIntervalMs" value="3000" />

<!-- Maximum scanner reconnect interval with exponential backoff in ms (default: 30000) -->
<add key="ScannerMaxReconnectIntervalMs" value="30000" />

<!-- Acuant/Gemalto SDK license key -->
<add key="License" value="4CC2DFW71CTJ543P" />
</appSettings>
</configuration>
