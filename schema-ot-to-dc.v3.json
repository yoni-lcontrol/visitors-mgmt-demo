    "/api/events/amadeus": {
      "post": {
        "summary": "Send Amadeus realtime events batch",
        "operationId": "sendAmadeusEvents",
        "description": "Called by Amadeus8 to forward a batch of realtime events. Events are deduplicated by externalEventId. Each event is logged, processed, and broadcast via WebSocket. Response is wrapped in ApiResponseEnvelope.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BackendAmadeusEventDto"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch result — one entry per event (wrapped in envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseEnvelope_AmadeusEventBatchResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get Amadeus events with pagination (authenticated)",
        "operationId": "getRecentAmadeusEvents",
        "description": "Returns paginated Amadeus events from the event log. Requires AccessControlRead permission (JWT bearer). Not called by the C# service — used by the Angular frontend. Response is wrapped in ApiResponseEnvelope.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": { "type": "integer", "default": 1 },
            "description": "Page number (1-based)"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": { "type": "integer", "default": 25 },
            "description": "Items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated event log entries (wrapped in envelope)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponseEnvelope_PaginatedAmadeusEventLogEntry"
                }
              }
            }
          }
        }
      }
    },
    "/api/access-control/import/callback": {
      "post": {
        "summary": "Import callback — deliver device import data",
        "operationId": "importCallback",
        "description": "⚠️ NOT currently called by C# BackendApiClient (polling via GET /api/import/status/{jobId} is used instead). This NestJS endpoint exists to receive the full import payload as a push callback. Marked @Public() — no auth required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportCallbackPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Callback processed successfully"
          }
        }
      }
    },
    "/api/access-control/import/access-levels/callback": {
      "post": {
        "summary": "Access-level import callback — deliver access-level data",
        "operationId": "accessLevelImportCallback",
        "description": "⚠️ NOT currently called by C# BackendApiClient (polling is used instead). This NestJS endpoint exists to receive access-level import results as a push callback. Marked @Public() — no auth required.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccessLevelCallbackPayload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Callback processed successfully"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "EmptyRequestBody": {
        "title": "EmptyRequestBody",
        "description": "Endpoint takes no input — request body must be an empty JSON object. Extra properties are rejected.",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "ApiResponseEnvelope": {
        "title": "ApiResponseEnvelope",
        "description": "Global response wrapper applied by NestJS TransformResponseInterceptor to ALL responses. The C# BackendApiClient uses BackendApiEnvelope<T> to unwrap .data for GET endpoints.",
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "description": "The actual response payload (type varies per endpoint)" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
      "ApiResponseEnvelope_SyncResultDto": {
        "title": "ApiResponseEnvelope<SyncResultDto>",
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/SyncResultDto" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
