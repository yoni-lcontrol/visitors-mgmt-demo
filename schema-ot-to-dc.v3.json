          "data": { "type": "array", "items": { "$ref": "#/components/schemas/BackendControllerDto" } },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
      "ApiResponseEnvelope_BackendDoorDtoList": {
