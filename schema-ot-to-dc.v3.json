        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/BackendExtensionDto" } },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
      "ApiResponseEnvelope_BackendExtensionIoDtoList": {
        "title": "ApiResponseEnvelope<BackendExtensionIoDto[]>",
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "type": "array", "items": { "$ref": "#/components/schemas/BackendExtensionIoDto" } },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
      "ApiResponseEnvelope_AmadeusEventBatchResponse": {
        "title": "ApiResponseEnvelope<AmadeusEventBatchResponse>",
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/AmadeusEventBatchResponse" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
      "ApiResponseEnvelope_PaginatedAmadeusEventLogEntry": {
        "title": "ApiResponseEnvelope<PaginatedResult<AmadeusEventLogEntry>>",
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "data": { "$ref": "#/components/schemas/PaginatedAmadeusEventLogEntry" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["success", "data", "timestamp"]
      },
      "PaginatedAmadeusEventLogEntry": {
        "title": "PaginatedResult<AmadeusEventLogEntry>",
        "description": "Standard paginated response returned by GET /api/events/amadeus.",
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/AmadeusEventLogEntry" }
          },
          "total": { "type": "integer" },
          "page": { "type": "integer" },
          "limit": { "type": "integer" },
          "totalPages": { "type": "integer" }
        },
        "required": ["items", "total", "page", "limit", "totalPages"]
      },
      "SyncResultDto": {
        "title": "SyncResultDto",
        "description": "Returned by all POST /api/sync/* endpoints. Maps to C# SyncResultDto and NestJS SyncResultResponseDto.",
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "operation": { "type": "string", "description": "e.g. 'full', 'controllers', 'doors'" },
          "startedUtc": { "type": "string", "format": "date-time" },
          "completedUtc": { "type": ["string", "null"], "format": "date-time" },
          "totalReceived": { "type": "integer" },
          "created": { "type": "integer" },
          "updated": { "type": "integer" },
          "unchanged": { "type": "integer" },
          "succeeded": { "type": "integer" },
          "skipped": { "type": "integer" },
          "failed": { "type": "integer" },
          "errorMessage": { "type": ["string", "null"] },
          "failures": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ImportFailureDetailDto" }
          }
        },
        "required": ["success", "operation", "startedUtc"]
      },
      "ImportFailureDetailDto": {
        "title": "ImportFailureDetailDto",
        "type": "object",
        "properties": {
          "occurredUtc": { "type": "string", "format": "date-time" },
          "equipmentType": { "type": "string" },
          "externalId": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] },
          "failureStage": { "type": "string" },
          "failureCategory": { "type": "string" },
          "message": { "type": "string" },
          "stackTrace": { "type": ["string", "null"] }
        },
        "required": ["occurredUtc", "equipmentType", "failureStage", "failureCategory", "message"]
      },
      "SyncErrorResponse": {
        "title": "SyncErrorResponse",
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "Sync operation failed" }
        }
      },
      "BackendControllerDto": {
        "title": "BackendControllerDto",
        "type": "object",
        "properties": {
          "id": { "type": ["string", "null"] },
          "externalId": { "type": ["string", "null"] },
          "amadeusUid": { "type": ["string", "null"] },
          "name": { "type": ["string", "null"] },
          "isActive": { "type": ["boolean", "null"] }
        }
      },
      "BackendDoorDto": {
        "title": "BackendDoorDto",
        "type": "object",
        "properties": {
